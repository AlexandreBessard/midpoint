                    <expression>
                        <proportional>
                            <style>value-only</style>
                        </proportional>
                    </expression>
                </dataField>
                <variation id="337">
                    <condition>
                        <script>
                            <code>proportional.value &gt; 0 &amp;&amp; proportional.value &lt; 3</code>
                        </script>
                    </condition>
                    <display>
                        <color>var(--orange)</color>
                    </display>
                </variation>
                <variation id="338">
                    <condition>
                        <script>
                            <code>proportional.value &gt;= 3</code>
