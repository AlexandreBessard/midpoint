                    <strength>weak</strength>
                    <expression>
                        <script>
                            <code>if (input != null) {
    def cleanInput = basic.trim(basic.norm(basic.stringify(input)))
    
    if (!basic.isEmpty(cleanInput)) {
        // 1. Supprime le préfixe ZZZ ou INT au début
        cleanInput = cleanInput.replaceAll(/(?i)^(ZZZ|INT)[\s\-_]*/, '')
        
        // 2. Extrait le nom (tout ce qui suit le prénom)
        def parts = cleanInput.split(/\s+/)
        if (parts.size() &gt; 1) {
            def familyName = parts[1..-1].join(' ')
            return familyName.toUpperCase()
        }
    }
}
return null</code>
