                    <name>Prénom</name>
                    <strength>weak</strength>
                    <expression>
                        <script>
                            <code>if (input != null) {
    def cleanInput = basic.trim(basic.norm(basic.stringify(input)))
    
    if (!basic.isEmpty(cleanInput)) {
        // 1. Supprime le préfixe ZZZ ou INT au début de la chaîne (insensible à la casse)
        cleanInput = cleanInput.replaceAll(/(?i)^(ZZZ|INT)[\s\-_]*/, '')
        
        // 2. Extrait le premier mot (Prénom)
        def parts = cleanInput.split(/\s+/)
        def givenName = parts[0]
        
        // 3. Majuscule sur chaque début de prénom (ex: jean-marie -&gt; Jean-Marie)
        return givenName.toLowerCase().replaceAll(/(?i)\b\w/) { it.toUpperCase() }
    }
}
return null</code>
