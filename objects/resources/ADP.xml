                                <code>if (input != null) {
    def cleanName = basic.trim(basic.norm(basic.stringify(input)))
    
    if (!basic.isEmpty(cleanName)) {
        // 1. On passe tout en minuscules
        // 2. On applique la majuscule après chaque début de mot ou tiret
        return cleanName.toLowerCase().replaceAll(/(?i)\b\w/) { it.toUpperCase() }
    }
}
return null</code>
