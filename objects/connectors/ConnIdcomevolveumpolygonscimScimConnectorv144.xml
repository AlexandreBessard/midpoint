<connector xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3" xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3" xmlns:icfs="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/resource-schema-3" xmlns:org="http://midpoint.evolveum.com/xml/ns/public/common/org-3" xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3" xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3" xmlns:t="http://prism.evolveum.com/xml/ns/public/types-3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" oid="cb07fe69-438f-4aec-a046-5ee33b864fb6" version="84" >
    <name>ConnId com.evolveum.polygon.scim.ScimConnector v1.4.4</name>
    <displayName>ScimConnector</displayName>
    <framework>http://midpoint.evolveum.com/xml/ns/public/connector/icf-1</framework>
    <connectorType>com.evolveum.polygon.scim.ScimConnector</connectorType>
    <connectorVersion>1.4.4</connectorVersion>
    <connectorBundle>com.evolveum.polygon.scim.connector-scim</connectorBundle>
    <namespace>http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/bundle/com.evolveum.polygon.scim.connector-scim/com.evolveum.polygon.scim.ScimConnector</namespace>
    <schema>
        <definition>
            <xsd:schema xmlns:a="http://prism.evolveum.com/xml/ns/public/annotation-3" xmlns:icfc="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/connector-schema-3" xmlns:qn863="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/connector-schema-3" xmlns:tns="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/bundle/com.evolveum.polygon.scim.connector-scim/com.evolveum.polygon.scim.ScimConnector" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/bundle/com.evolveum.polygon.scim.connector-scim/com.evolveum.polygon.scim.ScimConnector">
                <xsd:import namespace="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/connector-schema-3"/>
                <xsd:import namespace="http://prism.evolveum.com/xml/ns/public/types-3"/>
                <xsd:import namespace="http://prism.evolveum.com/xml/ns/public/annotation-3"/>
                <xsd:complexType name="ConfigurationType">
                    <xsd:sequence>
                        <xsd:element minOccurs="0" ref="qn863:connectorPoolConfiguration">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:type>qn863:ConnectorPoolConfigurationType</a:type>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" ref="icfc:producerBufferSize"/>
                        <xsd:element minOccurs="0" ref="icfc:timeouts">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:type>icfc:TimeoutsType</a:type>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" ref="icfc:resultsHandlerConfiguration">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:type>icfc:ResultsHandlerConfigurationType</a:type>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" ref="icfc:legacySchema"/>
                        <xsd:element ref="icfc:configurationProperties">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:type>tns:ConfigurationPropertiesType</a:type>
                                    <a:container/>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
                <xsd:complexType name="ConfigurationPropertiesType">
                    <xsd:sequence>
                        <xsd:element name="authentication" type="xsd:string">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:displayName>Authentication</a:displayName>
                                    <a:displayOrder>1</a:displayOrder>
                                    <a:help>Please provide the type of authentication</a:help>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" name="token" type="t:ProtectedStringType">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:displayName>Token</a:displayName>
                                    <a:displayOrder>2</a:displayOrder>
                                    <a:help>Please provide the token for a token type of authentication</a:help>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" name="userName" type="xsd:string">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:displayName>Username</a:displayName>
                                    <a:displayOrder>3</a:displayOrder>
                                    <a:help>Please provide the administrator user name for the scim enabled service you are logging into</a:help>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" name="password" type="t:ProtectedStringType">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:displayName>Password</a:displayName>
                                    <a:displayOrder>4</a:displayOrder>
                                    <a:help>Please provide the administrator password used to connect to the scim enabled service</a:help>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" name="clientSecret" type="t:ProtectedStringType">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:displayName>Clientsecret</a:displayName>
                                    <a:displayOrder>5</a:displayOrder>
                                    <a:help>Please provide the client token generated by the service endpoint for application interconnection</a:help>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" name="clientID" type="xsd:string">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:displayName>Client ID</a:displayName>
                                    <a:displayOrder>6</a:displayOrder>
                                    <a:help>Please provide the client token generated by the service endpoint for application interconnection</a:help>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="endpoint" type="xsd:string">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:displayName>Scim endpoint</a:displayName>
                                    <a:displayOrder>7</a:displayOrder>
                                    <a:help>Please provide the scim endpoint of the service provider (eg. /services/scim)</a:help>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="version" type="xsd:string">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:displayName>Scim version</a:displayName>
                                    <a:displayOrder>8</a:displayOrder>
                                    <a:help>Please provide the scim version which is supported by the service provider (eq. /v1)</a:help>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" name="loginURL" type="xsd:string">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:displayName>Login url</a:displayName>
                                    <a:displayOrder>9</a:displayOrder>
                                    <a:help>Please provide the Url address for log in</a:help>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" name="service" type="xsd:string">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:displayName>Grant type</a:displayName>
                                    <a:displayOrder>10</a:displayOrder>
                                    <a:help>Please provide the ulr snippet defining the service and grand type to log into the service (eg. /services/oauth2/token?grant_type=password)</a:help>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" name="baseUrl" type="xsd:string">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:displayName>Base URL</a:displayName>
                                    <a:displayOrder>11</a:displayOrder>
                                    <a:help>Please provide the base url for a token type of authentication</a:help>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" name="proxyUrl" type="xsd:string">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:displayName>Proxy adress</a:displayName>
                                    <a:displayOrder>12</a:displayOrder>
                                    <a:help>Please provide the adress of the proxy host.</a:help>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" name="proxyPortNumber" type="xsd:int">
                            <xsd:annotation>
                                <xsd:appinfo>
                                    <a:displayName>Proxy port number</a:displayName>
                                    <a:displayOrder>13</a:displayOrder>
                                    <a:help>Please provide the port number of the proxy host</a:help>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
                <xsd:element name="connectorConfiguration" type="tns:ConfigurationType">
                    <xsd:annotation>
                        <xsd:appinfo>
                            <a:container/>
                        </xsd:appinfo>
                    </xsd:annotation>
                </xsd:element>
            </xsd:schema>
        </definition>
    </schema>
    <available>true</available>
</connector>
